# Copy to `.env` for local work. On Cloudflare Pages add the same names as environment variables
# (Settings > Variables and Secrets) and redeploy: Vite bakes them in at build time.
#
# Download buttons: set one, both, or neither.
#   - Play Store URL set      -> "Get it on Google Play" button
#   - APK URL set             -> "Download APK" button (direct download from this page)
#   - neither set             -> a "Coming soon" badge instead
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.jynn7.sonivex
# Absolute URL (e.g. a GitHub release asset or Cloudflare R2 public URL) or a path such as /downloads/sonivex.apk
VITE_APK_URL=

VITE_PRIVACY_POLICY_URL=https://drop-6cde8067-d73.cheahjynn.workers.dev/
# Public address of this site, used for the social-share tags (no trailing slash). Optional.
VITE_SITE_URL=

VITE_APP_NAME=Sonivex
VITE_APP_TAGLINE=Your music, kept on your device.
VITE_APP_VERSION=0.0.3
VITE_MIN_ANDROID=10
VITE_SUPPORT_EMAIL=cheahjynn@gmail.com
VITE_DEVELOPER_NAME=Cheah Jynn
